{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "postinstall": "node scripts/prisma-generate.js",
    "db:generate": "node scripts/prisma-compose.js && prisma generate",
    "db:generate:prod": "node scripts/prisma-compose.js prod && prisma generate --schema=prisma/schema.prod.prisma",
    "db:push": "node scripts/prisma-compose.js && prisma db push",
    "db:migrate:dev": "node scripts/prisma-compose.js && prisma migrate dev",
    "db:migrate:prod": "node scripts/prisma-compose.js prod && prisma migrate deploy --schema=prisma/schema.prod.prisma"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@langchain/community": "^1.0.7",
    "@langchain/core": "^1.1.36",
    "@langchain/openai": "^1.3.1",
    "@langchain/textsplitters": "^1.0.1",
    "@types/cors": "^2.8.19",
    "chromadb": "^3.4.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-ws": "^5.0.2",
    "jose": "^4.15.9",
    "js-yaml": "^4.1.0",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "@prisma/client": "^6.0.0",
    "prisma": "^6.0.0",
    "pg": "^8.20.0",
    "swagger-ui-express": "^5.0.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "fsevents": "2.3.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-ws": "^3.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.6",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  }
}
