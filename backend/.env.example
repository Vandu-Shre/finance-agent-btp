# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_INSTANCE_NAME=your-instance
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Chat/LLM Model - Used for generating responses and conversations
# Examples: gpt-4, gpt-4o, gpt-35-turbo, etc.
AZURE_OPENAI_DEPLOYMENT_NAME=your-chat-model-deployment-name

# Embedding Model - Used for document search and retrieval (vector embeddings)
# Examples: text-embedding-ada-002, text-embedding-3-small, text-embedding-3-large
# IMPORTANT: This MUST be an embedding model, not a chat model
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=your-embedding-model-deployment-name

# Chroma Cloud Configuration (from trychroma.com)
# Get your API key from: https://trychroma.com/
CHROMA_API_KEY=your_chroma_cloud_api_key
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_COLLECTION_NAME=finance-docs

# Model Configuration (optional)
TEMPERATURE=0.7

# Server Configuration
PORT=3001
