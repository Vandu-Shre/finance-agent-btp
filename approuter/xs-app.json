{
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/api/chat$",
      "target": "/api/chat",
      "destination": "backend",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/api/files$",
      "target": "/api/files",
      "destination": "backend",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/api/files/(.*)$",
      "target": "/api/files/$1",
      "destination": "backend",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/api/(.*)$",
      "target": "/api/$1",
      "destination": "backend",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^(.*)$",
      "localDir": "resources",
      "authenticationType": "xsuaa",
      "csrfProtection": false,
      "cacheControl": "public, max-age=31536000, immutable"
    }
  ],
  "websockets": {
    "enabled": true
  },
  "compression": {
    "enabled": true,
    "minSize": 2048
  }
}
